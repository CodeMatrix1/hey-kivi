# Hey Kivi Phase 1 — copy to hindsight_pipeline_2/.env for Docker Compose
#
# Hey Kivi internal LLM supports ONLY groq or gemini (LLM_PROVIDER).
# Hindsight container uses separate HINDSIGHT_API_LLM_* vars (Groq below).

# --- Hey Kivi LLM (interpret / polish / synthesize) ---
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Optional: Gemini instead of Groq for Hey Kivi only
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# --- Hindsight service ---
HINDSIGHT_BASE_URL=http://localhost:8888
# Must match baseline snapshot (bank id: kivi_<user_id>). Use kivi2 only for fresh empty volumes.
HINDSIGHT_BANK_PREFIX=kivi
HINDSIGHT_RECALL_BUDGET=mid
HINDSIGHT_API_KEY=

# Hindsight container LLM (docker-compose.yml — same Groq key typical)
HINDSIGHT_API_LLM_PROVIDER=groq
HINDSIGHT_API_LLM_MODEL=openai/gpt-oss-20b
HINDSIGHT_API_LLM_GROQ_SERVICE_TIER=on_demand

# --- Hey Kivi app ---
KIVI_DEFAULT_USER_ID=golden_goose_eval_user
# KIVI_DEFAULT_USER_NAME=Aaditya
# Host dev: artifacts/runtime/kivi.sqlite3  |  Docker: set automatically in compose
KIVI2_DB_PATH=artifacts/runtime/kivi.sqlite3
KIVI_API_PORT=8002
KIVI_REQUIRE_LLM=true
# When true, substantive chat turns are retained in Hindsight (kivi_chat=true) — not dictation rows
KIVI_CHAT=false
KIVI_MEMORY_BACKEND=hindsight

# --- Cost instrumentation (optional) ---
KIVI_ESTIMATED_LLM_COST_USD=0
KIVI_ESTIMATED_RETAIN_COST_USD=0

# --- Corpus import (CLI) ---
HINDSIGHT_RETAIN_MIN_INTERVAL_SECONDS=30
